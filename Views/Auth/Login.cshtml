@model ClaimIT.Models.LoginViewModel

@{
    ViewData["Title"] = "Login - ClaimIT";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card login-card">
                <div class="card-header text-center">
                    <h3><i class="bi bi-clipboard-data"></i> ClaimIT</h3>
                    <p class="text-muted">Contract Monthly Claim System</p>
                </div>
                <div class="card-body">
                    <form asp-action="Login" method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input">
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Sign In</button>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <small class="text-muted">Demo Accounts:</small>
                    <div class="demo-accounts mt-2">
                        <div><strong>Lecturer:</strong> lecturer@university.com / lecturer123</div>
                        <div><strong>Coordinator:</strong> coordinator@university.com / coordinator123</div>
                        <div><strong>Manager:</strong> manager@university.com / manager123</div>
                        <div><strong>HR:</strong> hr@university.com / hr123</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .demo-accounts {
        font-size: 0.8rem;
        text-align: left;
    }

        .demo-accounts div {
            margin-bottom: 5px;
            padding: 5px;
            background: #f8f9fa;
            border-radius: 5px;
        }
</style>