@model List<ClaimIT.Models.Claim>

@{
    ViewData["Title"] = "ClaimIT Dashboard";
}

<div class="dashboard-header">
    <div class="container">
        <h1 class="display-4">ClaimIT Dashboard</h1>
        <p class="lead">Contract Monthly Claim System</p>
    </div>
</div>

<div class="container mt-4">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Quick Stats -->
    <div class="row">
        <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="card-icon">📊</div>
                    <div class="flex-grow-1">
                        <h5 class="card-title">Total Claims</h5>
                        <h2 class="card-value" style="color: #2C3E50">@Model.Count</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="card-icon">⏳</div>
                    <div class="flex-grow-1">
                        <h5 class="card-title">Pending</h5>
                        <h2 class="card-value" style="color: #2C3E50">@Model.Count(c => c.Status == "Pending")</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="card-icon">✅</div>
                    <div class="flex-grow-1">
                        <h5 class="card-title">Approved</h5>
                        <h2 class="card-value" style="color: #2C3E50">@Model.Count(c => c.Status == "Approved")</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="card-icon">🔍</div>
                    <div class="flex-grow-1">
                        <h5 class="card-title">Verified</h5>
                        <h2 class="card-value" style="color: #2C3E50">@Model.Count(c => c.Status == "Verified")</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Recent Claims</h5>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">New Claim</a>
                <a href="@Url.Action("ApprovalQueue")" class="btn btn-outline-primary btn-sm">Approval Queue</a>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Lecturer</th>
                                <th>Hours</th>
                                <th>Rate</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td><strong>@claim.Id</strong></td>
                                    <td>@claim.LecturerName</td>
                                    <td>@claim.HoursWorked</td>
                                    <td>R @claim.HourlyRate</td>
                                    <td><strong>R @claim.TotalAmount</strong></td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(claim.Status)">
                                            @claim.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = claim.Id })" class="btn btn-outline-secondary btn-sm">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <p>No claims found. <a href="@Url.Action("Create")">Create your first claim</a></p>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        switch (status)
        {
            case "Pending":
                return "badge-pending";
            case "Verified":
                return "badge-verified";
            case "Approved":
                return "badge-approved";
            case "Rejected":
                return "badge-rejected";
            default:
                return "bg-secondary";
        }
    }
}