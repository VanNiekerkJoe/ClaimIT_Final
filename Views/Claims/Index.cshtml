@model List<ClaimIT.Models.Claim>

@{
    ViewData["Title"] = "ClaimIT Dashboard";
}

<div class="dashboard-header">
    <div class="container">
        <h1 class="display-4">ClaimIT Dashboard</h1>
        <p class="lead">Contract Monthly Claim System</p>
    </div>
</div>

<div class="container mt-4">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Content Area -->
        <div class="col-lg-9">
            <!-- Stat Cards Row -->
            <div class="row mb-4">
                <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center">
                            <div class="card-icon">📊</div>
                            <div class="flex-grow-1">
                                <h5 class="card-title">Total Claims</h5>
                                <h2 class="card-value" style="color: #2C3E50">@Model.Count</h2>
                                <div class="text-end">
                                    <span class="card-trend" style="color: #27AE60">+5%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center">
                            <div class="card-icon">⏳</div>
                            <div class="flex-grow-1">
                                <h5 class="card-title">Pending Claims</h5>
                                <h2 class="card-value" style="color: #2C3E50">@Model.Count(c => c.Status == "Pending")</h2>
                                <div class="text-end">
                                    <span class="card-trend" style="color: #E74C3C">-2%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center">
                            <div class="card-icon">✅</div>
                            <div class="flex-grow-1">
                                <h5 class="card-title">Approved Claims</h5>
                                <h2 class="card-value" style="color: #2C3E50">@Model.Count(c => c.Status == "Approved")</h2>
                                <div class="text-end">
                                    <span class="card-trend" style="color: #27AE60">+10%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center">
                            <div class="card-icon">🔍</div>
                            <div class="flex-grow-1">
                                <h5 class="card-title">Verified Claims</h5>
                                <h2 class="card-value" style="color: #2C3E50">@Model.Count(c => c.Status == "Verified")</h2>
                                <div class="text-end">
                                    <span class="card-trend" style="color: #3498DB">+3%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Claims</h5>
                    <div>
                        <a href="@Url.Action("Create")" class="btn btn-primary me-2">Submit New Claim</a>
                        <a href="@Url.Action("ApprovalQueue")" class="btn btn-outline-primary">Approval Queue</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Lecturer</th>
                                    <th>Hours</th>
                                    <th>Rate</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Documents</th>
                                    <th>Submitted</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    <tr>
                                        <td><strong>@claim.Id</strong></td>
                                        <td>@claim.LecturerName</td>
                                        <td>@claim.HoursWorked</td>
                                        <td>R @claim.HourlyRate</td>
                                        <td><strong>R @claim.TotalAmount</strong></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="badge @GetStatusBadgeClass(claim.Status) me-2">
                                                    @claim.Status
                                                </span>
                                                @if (claim.Status == "Pending")
                                                {
                                                    <div class="status-indicator bg-warning"></div>
                                                }
                                                else if (claim.Status == "Verified")
                                                {
                                                    <div class="status-indicator bg-info"></div>
                                                }
                                                else if (claim.Status == "Approved")
                                                {
                                                    <div class="status-indicator bg-success"></div>
                                                }
                                                else if (claim.Status == "Rejected")
                                                {
                                                    <div class="status-indicator bg-danger"></div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (claim.DocumentNames != null && claim.DocumentNames.Any())
                                            {
                                                <small class="text-success">@claim.DocumentNames.Count files</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">No documents</small>
                                            }
                                        </td>
                                        <td>@claim.SubmittedDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                @if (claim.Status == "Pending")
                                                {
                                                    <a href="@Url.Action("Verify", new { id = claim.Id })" class="btn btn-warning">Verify</a>
                                                }
                                                @if (claim.Status == "Verified")
                                                {
                                                    <a href="@Url.Action("Approve", new { id = claim.Id })" class="btn btn-success">Approve</a>
                                                }
                                                <a href="@Url.Action("Details", new { id = claim.Id })" class="btn btn-outline-secondary">View</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Sidebar -->
        <div class="col-lg-3">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Create")" class="btn btn-primary mb-2">Add New Claim</a>
                        <a href="@Url.Action("Create")" class="btn btn-outline-primary mb-2">Upload Documents</a>
                        <a href="@Url.Action("ApprovalQueue")" class="btn btn-outline-primary mb-2">Verify and Approve</a>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">View All Claims</a>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Activity</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0">
                            <small class="text-success">✓ Claim #3 approved</small>
                            <br><small class="text-muted">2 hours ago</small>
                        </div>
                        <div class="list-group-item px-0">
                            <small class="text-info">↻ Claim #2 verified</small>
                            <br><small class="text-muted">4 hours ago</small>
                        </div>
                        <div class="list-group-item px-0">
                            <small class="text-warning">⏳ Claim #4 submitted</small>
                            <br><small class="text-muted">1 day ago</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        switch (status)
        {
            case "Pending":
                return "badge-pending";
            case "Verified":
                return "badge-verified";
            case "Approved":
                return "badge-approved";
            case "Rejected":
                return "badge-rejected";
            default:
                return "bg-secondary";
        }
    }
}