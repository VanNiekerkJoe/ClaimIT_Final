@model ClaimIT.Models.Claim

@{
    ViewData["Title"] = "Submit New Claim";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Submit Monthly Claim</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="LecturerName" class="form-label">Lecturer Name</label>
                                    <input asp-for="LecturerName" class="form-control" />
                                    <span asp-validation-for="LecturerName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="HoursWorked" class="form-label">Hours Worked</label>
                                    <input asp-for="HoursWorked" class="form-control" type="number" step="0.5" />
                                    <span asp-validation-for="HoursWorked" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="HourlyRate" class="form-label">Hourly Rate (R)</label>
                                    <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Total Amount (R)</label>
                                    <input type="text" class="form-control" value="R 0.00" readonly id="totalAmount" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Notes" class="form-label">Additional Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Supporting Documents</label>
                            <input type="file" name="documents" class="form-control" multiple
                                   accept=".pdf,.docx,.xlsx,.jpg,.png" />
                            <small class="form-text text-muted">
                                Upload supporting documents (PDF, Word, Excel, Images). Max file size: 5MB
                            </small>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary">Submit Claim</button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-calculate total amount
        $('#HoursWorked, #HourlyRate').on('input', function() {
            var hours = parseFloat($('#HoursWorked').val()) || 0;
            var rate = parseFloat($('#HourlyRate').val()) || 0;
            var total = hours * rate;
            $('#totalAmount').val('R ' + total.toFixed(2));
        });
    </script>
}