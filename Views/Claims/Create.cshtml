@model ClaimIT.Models.Claim

@{
    ViewData["Title"] = "Submit New Claim";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Form Progress -->
            <div class="form-progress mb-4">
                <div class="progress-steps">
                    <div class="step active" data-step="1">
                        <div class="step-circle">1</div>
                        <div class="step-label">Basic Info</div>
                    </div>
                    <div class="step" data-step="2">
                        <div class="step-circle">2</div>
                        <div class="step-label">Hours & Rate</div>
                    </div>
                    <div class="step" data-step="3">
                        <div class="step-circle">3</div>
                        <div class="step-label">Documents</div>
                    </div>
                    <div class="step" data-step="4">
                        <div class="step-circle">4</div>
                        <div class="step-label">Review</div>
                    </div>
                </div>
            </div>

            <div class="card form-card">
                <div class="card-header">
                    <h4 class="mb-0">Submit Monthly Claim</h4>
                    <p class="text-muted mb-0">Logged in as: @Context.Session.GetString("UserName")</p>
                </div>
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data" id="claimForm">
                        <!-- Hidden field for LecturerEmail -->
                        <input type="hidden" asp-for="LecturerEmail" id="lecturerEmail" />

                        <!-- Step 1: Basic Information -->
                        <div class="form-step active" data-step="1">
                            <h5 class="step-title">Basic Information</h5>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> Your personal information is automatically filled from your profile.
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="LecturerName" class="form-control" placeholder="Enter lecturer name" readonly />
                                        <label asp-for="LecturerName">Lecturer Name</label>
                                        <span asp-validation-for="LecturerName" class="text-danger validation-message"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="LecturerEmail" class="form-control" placeholder="Enter email" readonly />
                                        <label asp-for="LecturerEmail">Email Address</label>
                                        <span asp-validation-for="LecturerEmail" class="text-danger validation-message"></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-floating mb-3">
                                        <textarea asp-for="Notes" class="form-control" placeholder="Enter additional notes" style="height: 100px"></textarea>
                                        <label asp-for="Notes">Additional Notes</label>
                                        <span asp-validation-for="Notes" class="text-danger validation-message"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: Hours & Rate -->
                        <div class="form-step" data-step="2">
                            <h5 class="step-title">Hours & Rate</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="HoursWorked" class="form-control" type="number" step="0.5" min="1" max="200" placeholder="Enter hours worked" />
                                        <label asp-for="HoursWorked">Hours Worked *</label>
                                        <span asp-validation-for="HoursWorked" class="text-danger validation-message"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" min="20" max="500" placeholder="Enter hourly rate"
                                               value="@ViewBag.DefaultHourlyRate" />
                                        <label asp-for="HourlyRate">Hourly Rate (R) *</label>
                                        <span asp-validation-for="HourlyRate" class="text-danger validation-message"></span>
                                        <small class="text-muted">Your default rate: R @ViewBag.DefaultHourlyRate</small>
                                    </div>
                                </div>
                            </div>
                            <div class="calculation-preview">
                                <div class="preview-card">
                                    <h6>Amount Preview</h6>
                                    <div class="preview-row">
                                        <span>Hours:</span>
                                        <span id="previewHours">0</span>
                                    </div>
                                    <div class="preview-row">
                                        <span>Rate:</span>
                                        <span id="previewRate">R 0.00</span>
                                    </div>
                                    <div class="preview-row total">
                                        <strong>Total:</strong>
                                        <strong id="previewTotal">R 0.00</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Documents -->
                        <div class="form-step" data-step="3">
                            <h5 class="step-title">Supporting Documents</h5>
                            <div class="file-upload-area">
                                <input type="file" name="documents" class="file-input" id="fileInput" multiple
                                       accept=".pdf,.docx,.xlsx,.jpg,.png,.jpeg" />
                                <div class="upload-placeholder" id="uploadPlaceholder">
                                    <i class="bi bi-cloud-upload"></i>
                                    <h6>Drop files here or click to upload</h6>
                                    <p class="text-muted">Supports PDF, Word, Excel, Images (Max 5MB each)</p>
                                </div>
                                <div class="file-list" id="fileList"></div>
                            </div>
                        </div>

                        <!-- Step 4: Review -->
                        <div class="form-step" data-step="4">
                            <h5 class="step-title">Review & Submit</h5>
                            <div class="review-summary">
                                <div class="review-item">
                                    <strong>Lecturer Name:</strong>
                                    <span id="reviewLecturerName">—</span>
                                </div>
                                <div class="review-item">
                                    <strong>Email:</strong>
                                    <span id="reviewLecturerEmail">—</span>
                                </div>
                                <div class="review-item">
                                    <strong>Hours Worked:</strong>
                                    <span id="reviewHoursWorked">—</span>
                                </div>
                                <div class="review-item">
                                    <strong>Hourly Rate:</strong>
                                    <span id="reviewHourlyRate">—</span>
                                </div>
                                <div class="review-item">
                                    <strong>Total Amount:</strong>
                                    <span id="reviewTotalAmount" class="text-success">—</span>
                                </div>
                                <div class="review-item">
                                    <strong>Documents:</strong>
                                    <span id="reviewDocuments">0 files</span>
                                </div>
                            </div>
                        </div>

                        <!-- Form Navigation -->
                        <div class="form-navigation mt-4">
                            <button type="button" class="btn btn-outline-secondary" id="prevBtn" disabled>Previous</button>
                            <button type="button" class="btn btn-primary" id="nextBtn">Next</button>
                            <button type="submit" class="btn btn-success" id="submitBtn" style="display: none;">
                                Submit Claim
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-fill lecturer information
            const lecturerName = '@Context.Session.GetString("UserName")';
            const lecturerEmail = '@Context.Session.GetString("UserEmail")';

            if (lecturerName && document.querySelector('#LecturerName')) {
                document.querySelector('#LecturerName').value = lecturerName;
            }

            if (lecturerEmail && document.querySelector('#LecturerEmail')) {
                document.querySelector('#LecturerEmail').value = lecturerEmail;
                document.querySelector('#lecturerEmail').value = lecturerEmail;
            }

            initializeMultiStepForm();
            initializeRealTimeCalculations();
            initializeFileUpload();
        });

        function initializeMultiStepForm() {
            const steps = document.querySelectorAll('.form-step');
            const progressSteps = document.querySelectorAll('.progress-steps .step');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const submitBtn = document.getElementById('submitBtn');
            let currentStep = 1;

            function showStep(step) {
                steps.forEach(s => s.classList.remove('active'));
                progressSteps.forEach(s => s.classList.remove('active'));

                document.querySelector(`.form-step[data-step="${step}"]`).classList.add('active');
                document.querySelector(`.progress-steps .step[data-step="${step}"]`).classList.add('active');

                // Update navigation buttons
                prevBtn.disabled = step === 1;
                nextBtn.style.display = step === 4 ? 'none' : 'block';
                submitBtn.style.display = step === 4 ? 'block' : 'none';

                currentStep = step;
            }

            function validateStep(step) {
                let isValid = true;

                if (step === 1) {
                    const lecturerName = document.querySelector('#LecturerName').value;
                    const lecturerEmail = document.querySelector('#LecturerEmail').value;

                    if (!lecturerName.trim()) {
                        isValid = false;
                        showValidationError('LecturerName', 'Lecturer name is required');
                    }

                    if (!lecturerEmail.trim()) {
                        isValid = false;
                        showValidationError('LecturerEmail', 'Lecturer email is required');
                    }
                } else if (step === 2) {
                    const hours = document.querySelector('#HoursWorked').value;
                    const rate = document.querySelector('#HourlyRate').value;

                    if (!hours || hours < 1 || hours > 200) {
                        isValid = false;
                        showValidationError('HoursWorked', 'Hours must be between 1 and 200');
                    }

                    if (!rate || rate < 20 || rate > 500) {
                        isValid = false;
                        showValidationError('HourlyRate', 'Hourly rate must be between R20 and R500');
                    }
                }

                return isValid;
            }

            function showValidationError(fieldName, message) {
                // You can implement validation error display here
                console.log(`Validation error for ${fieldName}: ${message}`);
            }

            nextBtn.addEventListener('click', function() {
                if (validateStep(currentStep)) {
                    showStep(currentStep + 1);
                    updateReviewSummary();
                }
            });

            prevBtn.addEventListener('click', function() {
                showStep(currentStep - 1);
            });

            // Initialize first step
            showStep(1);
        }

        function initializeRealTimeCalculations() {
            const hoursInput = document.querySelector('#HoursWorked');
            const rateInput = document.querySelector('#HourlyRate');

            function updateCalculations() {
                const hours = parseFloat(hoursInput.value) || 0;
                const rate = parseFloat(rateInput.value) || 0;
                const total = hours * rate;

                document.getElementById('previewHours').textContent = hours;
                document.getElementById('previewRate').textContent = `R ${rate.toFixed(2)}`;
                document.getElementById('previewTotal').textContent = `R ${total.toFixed(2)}`;
            }

            hoursInput.addEventListener('input', updateCalculations);
            rateInput.addEventListener('input', updateCalculations);

            // Initial calculation
            updateCalculations();
        }

        function initializeFileUpload() {
            const fileInput = document.getElementById('fileInput');
            const uploadPlaceholder = document.getElementById('uploadPlaceholder');
            const fileList = document.getElementById('fileList');

            uploadPlaceholder.addEventListener('click', () => fileInput.click());

            uploadPlaceholder.addEventListener('dragover', (e) => {
                e.preventDefault();
                uploadPlaceholder.classList.add('dragover');
            });

            uploadPlaceholder.addEventListener('dragleave', () => {
                uploadPlaceholder.classList.remove('dragover');
            });

            uploadPlaceholder.addEventListener('drop', (e) => {
                e.preventDefault();
                uploadPlaceholder.classList.remove('dragover');
                fileInput.files = e.dataTransfer.files;
                updateFileList();
            });

            fileInput.addEventListener('change', updateFileList);

            function updateFileList() {
                fileList.innerHTML = '';
                const files = Array.from(fileInput.files);

                files.forEach((file, index) => {
                    const fileItem = document.createElement('div');
                    fileItem.className = 'file-item';

                    // Create preview for images
                    let previewHtml = '';
                    if (file.type.startsWith('image/')) {
                        previewHtml = `
                            <div class="file-preview-image">
                                <img src="${URL.createObjectURL(file)}" alt="${file.name}" class="img-thumbnail">
                            </div>
                        `;
                    } else if (file.type === 'application/pdf') {
                        previewHtml = `
                            <div class="file-preview-pdf">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </div>
                        `;
                    } else {
                        previewHtml = `
                            <div class="file-preview-generic">
                                <i class="bi bi-file-earmark"></i>
                            </div>
                        `;
                    }

                    fileItem.innerHTML = `
                        ${previewHtml}
                        <div class="file-info">
                            <span class="file-name">${file.name}</span>
                            <span class="file-size">(${formatFileSize(file.size)})</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger remove-file" data-index="${index}">
                            <i class="bi bi-trash"></i>
                        </button>
                    `;
                    fileList.appendChild(fileItem);
                });

                // Add remove file functionality
                document.querySelectorAll('.remove-file').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const index = parseInt(this.dataset.index);
                        removeFile(index);
                    });
                });
            }

            function removeFile(index) {
                const dt = new DataTransfer();
                const files = Array.from(fileInput.files);

                files.forEach((file, i) => {
                    if (i !== index) dt.items.add(file);
                });

                fileInput.files = dt.files;
                updateFileList();
            }

            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
            }
        }

        function updateReviewSummary() {
            // Update review summary with form data
            document.getElementById('reviewLecturerName').textContent = document.querySelector('#LecturerName').value || '—';
            document.getElementById('reviewLecturerEmail').textContent = document.querySelector('#LecturerEmail').value || '—';
            document.getElementById('reviewHoursWorked').textContent = document.querySelector('#HoursWorked').value || '—';
            document.getElementById('reviewHourlyRate').textContent = 'R ' + (document.querySelector('#HourlyRate').value || '0.00');
            document.getElementById('reviewTotalAmount').textContent = document.getElementById('previewTotal').textContent;
            document.getElementById('reviewDocuments').textContent = document.getElementById('fileInput').files.length + ' files';
        }
    </script>

    <style>
        /* Your existing CSS styles remain the same */
        .form-control[readonly] {
            background-color: #f8f9fa;
            opacity: 1;
        }
    </style>
}