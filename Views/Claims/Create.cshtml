@model ClaimIT.Models.Claim
@{
    ViewData["Title"] = "Submit New Claim";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <!-- Progress Steps -->
            <div class="progress-steps mb-5">
                <div class="step active" data-step="1"><span class="step-circle">1</span><span class="step-label">Basic Info</span></div>
                <div class="step" data-step="2"><span class="step-circle">2</span><span class="step-label">Hours & Rate</span></div>
                <div class="step" data-step="3"><span class="step-circle">3</span><span class="step-label">Documents</span></div>
                <div class="step" data-step="4"><span class="step-circle">4</span><span class="step-label">Review & Submit</span></div>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h3 class="mb-0">Submit Monthly Claim</h3>
                    <p class="mb-0 mt-2">Logged in as: <strong>@Context.Session.GetString("UserName")</strong></p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="claimForm">
                        @Html.AntiForgeryToken()

                        <!-- Hidden fields - auto-filled -->
                        <input type="hidden" asp-for="LecturerName" value="@Context.Session.GetString("UserName")" />
                        <input type="hidden" asp-for="LecturerEmail" value="@Context.Session.GetString("UserEmail")" />

                        <!-- Step 1: Basic Info -->
                        <div class="form-step active" data-step="1">
                            <h4 class="mb-4 text-primary">1. Basic Information</h4>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" value="@Context.Session.GetString("UserName")" readonly />
                                        <label>Lecturer Name</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="email" class="form-control" value="@Context.Session.GetString("UserEmail")" readonly />
                                        <label>Email Address</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-floating">
                                        <textarea asp-for="Notes" class="form-control" style="height: 130px" placeholder="Any special notes..."></textarea>
                                        <label asp-for="Notes">Additional Notes (Optional)</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: Hours & Rate -->
                        <div class="form-step" data-step="2">
                            <h4 class="mb-4 text-primary">2. Hours Worked & Hourly Rate</h4>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="HoursWorked" id="HoursWorked" class="form-control" type="number" step="0.5" min="0.5" max="300" required />
                                        <label asp-for="HoursWorked">Hours Worked <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="HourlyRate" id="HourlyRate" class="form-control" type="number" step="0.01" min="20" max="2000"
                                               value="@ViewBag.DefaultHourlyRate" required />
                                        <label asp-for="HourlyRate">Hourly Rate (R) <span class="text-danger">*</span></label>
                                        <small class="text-success fw-bold">Default: R @ViewBag.DefaultHourlyRate</small>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-5 p-4 bg-light rounded-4 border border-primary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="mb-0 text-primary">Total Claim Amount</h4>
                                    <h2 class="mb-0 text-success" id="liveTotal">R 0.00</h2>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Documents -->
                        <div class="form-step" data-step="3">
                            <h4 class="mb-4 text-primary">3. Supporting Documents</h4>
                            <p class="text-muted mb-4">Upload timesheets, contracts, proof of work (PDF, images, Word, Excel)</p>

                            <div class="file-upload-zone border-3 border-dashed rounded-4 p-5 text-center mb-4 bg-light" id="dropZone">
                                <input type="file" name="documents" id="fileInput" multiple accept=".pdf,.jpg,.jpeg,.png,.docx,.xlsx" class="d-none" />
                                <i class="bi bi-cloud-arrow-up-fill display-3 text-primary mb-3"></i>
                                <h5>Drop files here or click to upload</h5>
                                <p class="text-muted">Max 10MB per file • Multiple files allowed</p>
                            </div>

                            <div id="filePreview" class="row g-4"></div>
                        </div>

                        <!-- Step 4: Review -->
                        <div class="form-step" data-step="4">
                            <h4 class="mb-4 text-primary">4. Review & Submit</h4>
                            <div class="bg-light p-5 rounded-4 border">
                                <div class="row">
                                    <div class="col-md-7">
                                        <h5>Claim Summary</h5>
                                        <hr>
                                        <p><strong>Name:</strong> @Context.Session.GetString("UserName")</p>
                                        <p><strong>Email:</strong> @Context.Session.GetString("UserEmail")</p>
                                        <p><strong>Hours Worked:</strong> <span id="reviewHours">—</span></p>
                                        <p><strong>Hourly Rate:</strong> <span id="reviewRate">—</span></p>
                                        <p><strong>Notes:</strong> <span id="reviewNotes">None</span></p>
                                    </div>
                                    <div class="col-md-5 text-end">
                                        <h2 class="text-success mb-4">Total: <span id="reviewTotal">R 0.00</span></h2>
                                        <h5 class="text-muted"><span id="fileCount">0 files</span> attached</h5>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Navigation Buttons -->
                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" id="prevBtn" class="btn btn-lg btn-outline-secondary px-5" disabled>Previous</button>
                            <div>
                                <button type="button" id="nextBtn" class="btn btn-lg btn-primary px-5">Next</button>
                                <button type="submit" id="submitBtn" class="btn btn-lg btn-success px-5 d-none">
                                    Submit Claim
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Large Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Document Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-dark p-0 text-center">
                <iframe id="pdfViewer" width="100%" height="700" style="border:none;"></iframe>
                <img id="imageViewer" class="img-fluid d-none" style="max-height: 80vh;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const filesArray = [];
        let currentStep = 1;
        const totalSteps = 4;

        // AUTO CALCULATION — WORKS 100%
        function calculateTotal() {
            const hours = parseFloat(document.getElementById('HoursWorked').value) || 0;
            const rate = parseFloat(document.getElementById('HourlyRate').value) || 0;
            const total = hours * rate;

            const formatted = total.toLocaleString('en-ZA', { style: 'currency', currency: 'ZAR' });
            document.getElementById('liveTotal').textContent = formatted;
            document.getElementById('reviewTotal').textContent = formatted;
            document.getElementById('reviewHours').textContent = hours.toFixed(1);
            document.getElementById('reviewRate').textContent = 'R ' + rate.toFixed(2);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const hoursInput = document.getElementById('HoursWorked');
            const rateInput = document.getElementById('HourlyRate');

            hoursInput.addEventListener('input', calculateTotal);
            rateInput.addEventListener('input', calculateTotal);
            hoursInput.addEventListener('change', calculateTotal);
            rateInput.addEventListener('change', calculateTotal);

            calculateTotal(); // Initial
        });

        // File Upload
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const previewContainer = document.getElementById('filePreview');

        dropZone.addEventListener('click', () => fileInput.click());
        ['dragover', 'dragenter'].forEach(e => dropZone.addEventListener(e, () => dropZone.classList.add('border-primary', 'bg-primary-subtle')));
        ['dragleave', 'dragend', 'drop'].forEach(e => dropZone.addEventListener(e, () => dropZone.classList.remove('border-primary', 'bg-primary-subtle')));

        dropZone.addEventListener('drop', e => {
            e.preventDefault();
            handleFiles(e.dataTransfer.files);
        });
        fileInput.addEventListener('change', () => handleFiles(fileInput.files));

        function handleFiles(files) {
            [...files].forEach(file => {
                if (file.size > 10 * 1024 * 1024) {
                    alert('File too large: ' + file.name);
                    return;
                }
                if (filesArray.find(f => f.name === file.name && f.size === file.size)) return;

                filesArray.push(file);
                const reader = new FileReader();
                reader.onload = e => addPreview(file, e.target.result);
                reader.readAsDataURL(file);
            });
        }

        function addPreview(file, dataUrl) {
            const col = document.createElement('div');
            col.className = 'col-md-4 col-lg-3';
            const isPdf = file.type === 'application/pdf';

            col.innerHTML = `
                <div class="card shadow h-100">
                    <div class="card-body text-center p-3">
                        ${isPdf ? `<iframe src="${dataUrl}#toolbar=0" class="w-100 rounded" style="height:200px;"></iframe>`
                               : `<img src="${dataUrl}" class="img-fluid rounded" style="max-height:200px;">`}
                        <p class="small mt-2 mb-1 text-truncate fw-bold">${file.name}</p>
                        <div class="btn-group w-100 mt-2">
                            <button type="button" class="btn btn-outline-primary btn-sm preview-file">View</button>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-file">Remove</button>
                        </div>
                    </div>
                </div>
            `;

            previewContainer.appendChild(col);

            col.querySelector('.remove-file').onclick = () => {
                filesArray.splice(filesArray.indexOf(file), 1);
                col.remove();
                updateFileCount();
            };

            col.querySelector('.preview-file').onclick = () => {
                const modal = new bootstrap.Modal('#previewModal');
                if (isPdf) {
                    document.getElementById('pdfViewer').src = dataUrl + '#toolbar=0&zoom=100';
                    document.getElementById('pdfViewer').classList.remove('d-none');
                    document.getElementById('imageViewer').classList.add('d-none');
                } else {
                    document.getElementById('imageViewer').src = dataUrl;
                    document.getElementById('imageViewer').classList.remove('d-none');
                    document.getElementById('pdfViewer').classList.add('d-none');
                }
                modal.show();
            };
        }

        function updateFileCount() {
            const count = filesArray.length;
            document.getElementById('fileCount').textContent = count + ' file' + (count !== 1 ? 's' : '');
        }

        // Navigation
        document.getElementById('nextBtn').addEventListener('click', () => {
            if (currentStep === 2 && (!document.getElementById('HoursWorked').value || !document.getElementById('HourlyRate').value)) {
                alert('Please enter hours and rate');
                return;
            }
            if (currentStep < totalSteps) {
                currentStep++;
                updateSteps();
            }
        });

        document.getElementById('prevBtn').addEventListener('click', () => {
            if (currentStep > 1) {
                currentStep--;
                updateSteps();
            }
        });

        function updateSteps() {
            document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
            document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('active');

            document.querySelectorAll('.progress-steps .step').forEach(s => {
                s.classList.toggle('active', parseInt(s.dataset.step) <= currentStep);
            });

            document.getElementById('prevBtn').disabled = currentStep === 1;
            document.getElementById('nextBtn').style.display = currentStep === totalSteps ? 'none' : 'block';
            document.getElementById('submitBtn').classList.toggle('d-none', currentStep !== totalSteps);
        }

        // Submit
        document.getElementById('claimForm').addEventListener('submit', function(e) {
            if (filesArray.length === 0 && !confirm('No documents attached. Submit anyway?')) {
                e.preventDefault();
                return;
            }
            const dt = new DataTransfer();
            filesArray.forEach(f => dt.items.add(f));
            fileInput.files = dt.files;
        });

        updateFileCount();
    </script>

    <style>
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea, #764ba2) !important;
        }

        .file-upload-zone {
            transition: all 0.3s;
            cursor: pointer;
        }

        .progress-steps {
            display: flex;
            justify-content: space-between;
            position: relative;
        }

            .progress-steps::before {
                content: '';
                position: absolute;
                top: 22px;
                left: 50px;
                right: 50px;
                height: 4px;
                background: #e0e0e0;
                z-index: 0;
            }

        .step {
            z-index: 1;
            text-align: center;
        }

        .step-circle {
            width: 48px;
            height: 48px;
            background: #e0e0e0;
            color: #999;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .step.active .step-circle {
            background: #667eea;
            color: white;
            transform: scale(1.15);
        }

        .step-label {
            font-weight: 600;
            color: #666;
        }

        .step.active .step-label {
            color: #667eea;
        }
    </style>
}