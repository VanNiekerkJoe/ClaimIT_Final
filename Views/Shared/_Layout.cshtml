<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClaimIT</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <!-- AOS Animation Library -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet">

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #2C3E50;
            --accent-color: #3498DB;
            --secondary-color: #2980B9;
            --success-color: #27AE60;
            --warning-color: #E74C3C;
            --info-color: #17A2B8;
            --background-color: #F0F4F8;
            --light-gray: #ECF0F1;
            --text-dark: #2C3E50;
            --text-light: #6C757D;
        }

        /* Particle Background */
        #particles-js {
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        body {
            background-color: var(--background-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Enhanced Navbar */
        .navbar {
            background: linear-gradient(135deg, var(--primary-color), #34495E) !important;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            height: 70px;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            background: linear-gradient(45deg, #3498db, #2ecc71);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            font-weight: 500;
            padding: 0.5rem 1rem;
            margin: 0 0.2rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .nav-link:hover {
                background: rgba(255,255,255,0.1);
                transform: translateY(-2px);
            }

            .nav-link::before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 2px;
                background: linear-gradient(90deg, #3498db, #2ecc71);
                transition: all 0.3s ease;
                transform: translateX(-50%);
            }

            .nav-link:hover::before {
                width: 80%;
            }

        .live-clock {
            font-size: 14px;
            font-weight: 500;
            background: rgba(255,255,255,0.1);
            padding: 8px 15px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
        }

        /* User Info Styles */
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
            color: white;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3498db, #2ecc71);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: white;
            border: 2px solid rgba(255,255,255,0.3);
        }

        .user-details {
            display: flex;
            flex-direction: column;
        }

        .user-name {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .user-role {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        .role-badge {
            font-size: 0.7rem;
            padding: 4px 8px;
            border-radius: 12px;
            font-weight: 600;
        }

        /* Enhanced Stat Cards */
        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            border: none;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
                transition: left 0.5s ease;
            }

            .stat-card:hover::before {
                left: 100%;
            }

            .stat-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 15px 35px rgba(0,0,0,0.15);
            }

        .card-icon {
            font-size: 2.8rem;
            margin-right: 15px;
            opacity: 0.8;
            transition: all 0.3s ease;
        }

        .stat-card:hover .card-icon {
            transform: scale(1.1) rotate(5deg);
            opacity: 1;
        }

        .card-title {
            font-size: 0.9rem;
            color: var(--text-light);
            margin-bottom: 8px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-value {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 0;
            background: linear-gradient(45deg, var(--primary-color), var(--accent-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .card-trend {
            font-size: 0.9rem;
            font-weight: 700;
        }

        .trend-positive {
            color: var(--success-color) !important;
        }

        .trend-negative {
            color: var(--warning-color) !important;
        }

        /* Dashboard Header */
        .dashboard-header {
            background: linear-gradient(135deg, var(--primary-color), #34495E);
            color: white;
            padding: 3rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 25px 25px;
            position: relative;
            overflow: hidden;
        }

            .dashboard-header::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
            }

        .animated-title {
            background: linear-gradient(45deg, #3498db, #2ecc71, #e74c3c, #f39c12);
            background-size: 400% 400%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        /* Status Indicators */
        .status-indicators {
            display: flex;
            gap: 15px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: rgba(255,255,255,0.15);
            border-radius: 25px;
            color: white;
            font-size: 0.9rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.3s ease;
        }

            .status-indicator:hover {
                background: rgba(255,255,255,0.25);
                transform: translateY(-2px);
            }

        .pulse-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #2ecc71;
        }

        /* Enhanced Buttons */
        .btn {
            border-radius: 10px;
            font-weight: 600;
            padding: 10px 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(52, 152, 219, 0.4);
                background: linear-gradient(135deg, var(--secondary-color), var(--accent-color));
            }

        .btn-outline-primary {
            border: 2px solid var(--accent-color);
            color: var(--accent-color);
            background: transparent;
        }

            .btn-outline-primary:hover {
                background: var(--accent-color);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
            }

        .btn-outline-light {
            border: 2px solid rgba(255,255,255,0.3);
            color: white;
            background: transparent;
        }

            .btn-outline-light:hover {
                background: rgba(255,255,255,0.1);
                color: white;
                transform: translateY(-2px);
            }

        /* Enhanced Tables */
        .table {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            border: none;
        }

            .table th {
                background: linear-gradient(135deg, var(--primary-color), #34495E);
                color: white;
                border: none;
                padding: 15px;
                font-weight: 600;
            }

            .table td {
                padding: 15px;
                border-color: #f1f3f4;
                vertical-align: middle;
            }

        .table-hover tbody tr:hover {
            background: rgba(52, 152, 219, 0.05);
            transform: scale(1.01);
            transition: all 0.2s ease;
        }

        /* Badge Styles */
        .badge {
            font-size: 0.8rem;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-pending {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: white;
        }

        .badge-verified {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
        }

        .badge-approved {
            background: linear-gradient(135deg, #27ae60, #229954);
            color: white;
        }

        .badge-rejected {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
        }

        .badge-lecturer {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
        }

        .badge-coordinator {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: white;
        }

        .badge-manager {
            background: linear-gradient(135deg, #9b59b6, #8e44ad);
            color: white;
        }

        .badge-hr {
            background: linear-gradient(135deg, #27ae60, #229954);
            color: white;
        }

        /* Footer Enhancements */
        .footer {
            background: linear-gradient(135deg, var(--primary-color), #34495E);
            color: white;
            padding: 20px 0;
            margin-top: 3rem;
            border-radius: 25px 25px 0 0;
            position: relative;
            overflow: hidden;
        }

            .footer::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="dots" width="10" height="10" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect width="100" height="100" fill="url(%23dots)"/></svg>');
            }

        .progress {
            height: 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.2);
            overflow: hidden;
        }

        .progress-bar {
            border-radius: 10px;
            background: linear-gradient(90deg, #2ecc71, #3498db);
            transition: width 1s ease-in-out;
        }

        /* Loading Screen */
        .loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }

            .loading-screen.hidden {
                opacity: 0;
                visibility: hidden;
            }

        .loading-content {
            text-align: center;
            color: white;
        }

        .brand-logo {
            margin-bottom: 40px;
        }

        .logo-circle {
            width: 100px;
            height: 100px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid rgba(255, 255, 255, 0.3);
            position: relative;
            backdrop-filter: blur(10px);
        }

            .logo-circle::before {
                content: '📊';
                font-size: 3rem;
            }

        .logo-text {
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: 3px;
            background: linear-gradient(45deg, #fff, #e3f2fd);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .loading-progress {
            width: 300px;
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #2ecc71, #3498db);
            width: 0%;
            transition: width 0.3s ease;
            border-radius: 4px;
            position: relative;
            overflow: hidden;
        }

        .loading-steps {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
        }

            .loading-steps .step {
                transition: all 0.3s ease;
            }

                .loading-steps .step.active {
                    color: white;
                    font-weight: 600;
                    transform: scale(1.1);
                }

        /* Help Button */
        .help-button {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.8rem;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 8px 30px rgba(52, 152, 219, 0.4);
            z-index: 1000;
            transition: all 0.3s ease;
            border: 3px solid white;
        }

            .help-button:hover {
                transform: scale(1.1) rotate(10deg);
                box-shadow: 0 12px 40px rgba(52, 152, 219, 0.6);
            }

        /* Tutorial Styles */
        .tutorial-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9998;
            backdrop-filter: blur(10px);
        }

            .tutorial-overlay.hidden {
                display: none;
            }

        .tutorial-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        .tutorial-content {
            text-align: center;
            margin-bottom: 30px;
        }

        .tutorial-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .tutorial-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2C3E50;
            margin-bottom: 15px;
        }

        .tutorial-description {
            color: #6c757d;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .tutorial-highlight {
            background: linear-gradient(120deg, #a8e6cf, #dcedc1);
            padding: 10px 15px;
            border-radius: 8px;
            border-left: 4px solid #2ecc71;
            margin: 15px 0;
        }

        .tutorial-navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .tutorial-progress {
            font-weight: 600;
            color: #2C3E50;
        }

        .tutorial-step-indicators {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
        }

        .tutorial-step-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #e9ecef;
            transition: all 0.3s ease;
        }

            .tutorial-step-dot.active {
                background: #3498db;
                transform: scale(1.2);
            }

        /* Role-based Navigation Styles */
        .nav-divider {
            height: 20px;
            width: 1px;
            background: rgba(255,255,255,0.3);
            margin: 0 10px;
        }

        .role-section {
            border-left: 3px solid;
            padding-left: 10px;
            margin-left: 5px;
        }

        .role-lecturer {
            border-color: #3498db;
        }

        .role-coordinator {
            border-color: #f39c12;
        }

        .role-manager {
            border-color: #9b59b6;
        }

        .role-hr {
            border-color: #27ae60;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1.2rem;
            }

            .live-clock {
                font-size: 12px;
                padding: 6px 12px;
            }

            .dashboard-header {
                padding: 2rem 0;
            }

            .status-indicators {
                flex-direction: column;
                gap: 10px;
            }

            .help-button {
                width: 60px;
                height: 60px;
                bottom: 20px;
                right: 20px;
                font-size: 1.5rem;
            }

            .card-icon {
                font-size: 2.2rem;
            }

            .card-value {
                font-size: 1.8rem;
            }

            .tutorial-container {
                padding: 20px;
                margin: 20px;
            }

            .user-info {
                flex-direction: column;
                gap: 8px;
                text-align: center;
            }

            .user-details {
                align-items: center;
            }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(135deg, var(--secondary-color), var(--accent-color));
            }

        /* Focus States */
        .btn:focus,
        .form-control:focus,
        .nav-link:focus {
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.3);
            outline: none;
        }
    </style>

    <!-- Animation Styles -->
    <style>
        @@keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.5);
                opacity: 0.7;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes ripple {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        @@keyframes glow {
            from {
                box-shadow: 0 0 5px rgba(52, 152, 219, 0.3);
            }

            to {
                box-shadow: 0 0 15px rgba(52, 152, 219, 0.6);
            }
        }

        @@keyframes shimmer {
            0% {
                left: -100%;
            }

            100% {
                left: 100%;
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-10px);
            }

            60% {
                transform: translateY(-5px);
            }
        }

        /* Apply animations */
        .animated-title {
            animation: gradientShift 8s ease infinite;
        }

        .pulse-dot {
            animation: pulse 2s infinite;
        }

        .live-clock {
            animation: glow 2s ease-in-out infinite alternate;
        }

        .help-button {
            animation: pulse 2s infinite, float 4s ease-in-out infinite;
        }

        .brand-logo {
            animation: float 3s ease-in-out infinite;
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: shimmer 2s infinite;
        }

        .tutorial-container {
            animation: slideUp 0.5s ease-out;
        }

        .tutorial-icon {
            animation: bounce 2s infinite;
        }
    </style>
</head>
<body>
    <!-- Particle Background -->
    <div id="particles-js"></div>

    <!-- Loading Screen -->
    <div id="loadingScreen" class="loading-screen">
        <div class="loading-content">
            <div class="brand-logo">
                <div class="logo-circle"></div>
                <div class="logo-text">ClaimIT</div>
            </div>
            <div class="loading-progress">
                <div class="progress-bar">
                    <div class="progress-fill"></div>
                </div>
                <div class="loading-steps">
                    <span class="step active">Initializing</span>
                    <span class="step">Loading Data</span>
                    <span class="step">Ready</span>
                </div>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Claims" asp-action="Index">
                <i class="bi bi-clipboard-data me-2"></i>
                <strong>ClaimIT Dashboard</strong>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                @if (Context.Session.GetString("UserEmail") != null)
                {
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Common Navigation for All Roles -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Claims" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>

                        <!-- Lecturer Specific Navigation -->
                        @if (Context.Session.GetString("UserRole") == "Lecturer")
                        {
                            <span class="nav-divider d-none d-md-block"></span>
                            <li class="nav-item role-section role-lecturer">
                                <a class="nav-link" asp-controller="Claims" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i>New Claim
                                </a>
                            </li>
                            <li class="nav-item role-section role-lecturer">
                                <a class="nav-link" asp-controller="Claims" asp-action="Index">
                                    <i class="bi bi-list-check me-1"></i>My Claims
                                </a>
                            </li>
                        }

                        <!-- Coordinator & Manager Specific Navigation -->
                        @if (Context.Session.GetString("UserRole") == "Coordinator" || Context.Session.GetString("UserRole") == "Manager")
                        {
                            <span class="nav-divider d-none d-md-block"></span>
                            <li class="nav-item role-section @(Context.Session.GetString("UserRole") == "Coordinator" ? "role-coordinator" : "role-manager")">
                                <a class="nav-link" asp-controller="Claims" asp-action="ApprovalQueue">
                                    <i class="bi bi-clock-history me-1"></i>Approval Queue
                                    @{
                                        var pendingCount = 0; // This would come from your data context
                                        if (pendingCount > 0)
                                        {
                                            <span class="badge bg-danger ms-1">@pendingCount</span>
                                        }
                                    }
                                </a>
                            </li>
                            <li class="nav-item role-section @(Context.Session.GetString("UserRole") == "Coordinator" ? "role-coordinator" : "role-manager")">
                                <a class="nav-link" asp-controller="Claims" asp-action="Index">
                                    <i class="bi bi-eye me-1"></i>All Claims
                                </a>
                            </li>
                        }

                        <!-- HR Specific Navigation -->
                        @if (Context.Session.GetString("UserRole") == "HR")
                        {
                            <span class="nav-divider d-none d-md-block"></span>
                            <li class="nav-item role-section role-hr">
                                <a class="nav-link" asp-controller="HR" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>User Management
                                </a>
                            </li>
                            <li class="nav-item role-section role-hr">
                                <a class="nav-link" asp-controller="HR" asp-action="Reports">
                                    <i class="bi bi-graph-up me-1"></i>Reports & Analytics
                                </a>
                            </li>
                            <li class="nav-item role-section role-hr">
                                <a class="nav-link" asp-controller="HR" asp-action="Index">
                                    <i class="bi bi-file-earmark-text me-1"></i>Invoices
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- User Info and Controls -->
                    <div class="navbar-nav align-items-center">
                        <!-- Live Clock -->
                        <span class="navbar-text live-clock me-3" id="liveClock">
                            <i class="bi bi-clock me-1"></i>
                            Loading...
                        </span>

                        <!-- User Information -->
                        <div class="user-info me-3">
                            <div class="user-avatar">
                                @GetUserInitials(Context.Session.GetString("UserName"))
                            </div>
                            <div class="user-details">
                                <span class="user-name">@Context.Session.GetString("UserName")</span>
                                <span class="user-role">
                                    <span class="role-badge @GetRoleBadgeClass(Context.Session.GetString("UserRole"))">
                                        @Context.Session.GetString("UserRole")
                                    </span>
                                </span>
                            </div>
                        </div>

                        <!-- Logout Button -->
                        <a href="@Url.Action("Logout", "Auth")" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </a>
                    </div>
                }
                else
                {
                    <!-- Show only login link when not authenticated -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-white">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center">
                        <span>Claim Status Tracker</span>
                        <div class="progress mt-2 ms-2" style="width: 200px;">
                            <div class="progress-bar" role="progressbar" style="width: 75%;"
                                 aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span id="footerStatus">
                        <i class="bi bi-activity me-1"></i>
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <span>Logged in as <strong>@Context.Session.GetString("UserName")</strong> - </span>
                        }
                        Processing: 75% of claims completed
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Interactive Tutorial -->
    <div id="tutorialOverlay" class="tutorial-overlay hidden">
        <div class="tutorial-container">
            <div class="tutorial-content" id="tutorialContent">
                <!-- Tutorial steps will be injected here -->
            </div>
            <div class="tutorial-navigation mt-4">
                <button type="button" class="btn btn-outline-secondary" id="tutorialPrev">Previous</button>
                <div class="tutorial-progress">
                    <span id="tutorialStep">1</span> / <span id="tutorialTotal">5</span>
                </div>
                <button type="button" class="btn btn-primary" id="tutorialNext">Next</button>
                <button type="button" class="btn btn-success" id="tutorialComplete" style="display: none;">Get Started</button>
            </div>
        </div>
    </div>

    <!-- Help Button -->
    <div class="help-button" id="helpButton" title="Show Tutorial">
        <span>?</span>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>

    <script>
        // Loading screen functionality
        document.addEventListener('DOMContentLoaded', function() {
            const loadingScreen = document.getElementById('loadingScreen');
            const progressFill = document.querySelector('.progress-fill');
            const steps = document.querySelectorAll('.loading-steps .step');

            let progress = 0;
            const totalSteps = 3;
            let currentStep = 0;

            function updateProgress() {
                progress += Math.random() * 25;
                if (progress > 100) progress = 100;

                progressFill.style.width = progress + '%';

                // Update steps
                if (progress >= 33 && currentStep === 0) {
                    steps[0].classList.remove('active');
                    steps[1].classList.add('active');
                    currentStep = 1;
                } else if (progress >= 66 && currentStep === 1) {
                    steps[1].classList.remove('active');
                    steps[2].classList.add('active');
                    currentStep = 2;
                }

                if (progress < 100) {
                    setTimeout(updateProgress, 300 + Math.random() * 200);
                } else {
                    // Complete loading
                    setTimeout(() => {
                        loadingScreen.classList.add('hidden');
                        setTimeout(() => {
                            loadingScreen.remove();
                            // Initialize animations
                            if (typeof AOS !== 'undefined') {
                                AOS.init({
                                    duration: 800,
                                    once: true,
                                    offset: 100
                                });
                            }

                            // Show tutorial if first visit
                            if (!localStorage.getItem('claimit_tutorial_completed')) {
                                setTimeout(showTutorial, 1000);
                            }
                        }, 500);
                    }, 500);
                }
            }

            // Start loading progress
            setTimeout(updateProgress, 800);
        });

        // Live clock functionality
        function updateClock() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: true
            });
            const dateString = now.toLocaleDateString('en-US', {
                weekday: 'short',
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });

            const liveClock = document.getElementById('liveClock');
            if (liveClock) {
                liveClock.innerHTML = `<i class="bi bi-clock me-1"></i>${timeString} • ${dateString}`;
            }

            // Update footer status with random progress for demo
            const progress = 60 + Math.floor(Math.random() * 25);
            const footerStatus = document.getElementById('footerStatus');
            if (footerStatus) {
                let userInfo = '';
                @if (Context.Session.GetString("UserEmail") != null)
                {
                        @:userInfo = `Logged in as <strong>@Context.Session.GetString("UserName")</strong> - `;
                }
                footerStatus.innerHTML = `<i class="bi bi-activity me-1"></i>${userInfo}Processing: ${progress}% of claims completed as of ${timeString}`;
            }

            // Update progress bar
            const progressBar = document.querySelector('.footer .progress-bar');
            if (progressBar) {
                progressBar.style.width = `${progress}%`;
            }
        }

        updateClock();
        setInterval(updateClock, 1000);

        // Initialize particles.js
        if (typeof particlesJS !== 'undefined') {
            particlesJS('particles-js', {
                particles: {
                    number: {
                        value: 80,
                        density: {
                            enable: true,
                            value_area: 800
                        }
                    },
                    color: {
                        value: "#3498db"
                    },
                    shape: {
                        type: "circle"
                    },
                    opacity: {
                        value: 0.5,
                        random: true
                    },
                    size: {
                        value: 3,
                        random: true
                    },
                    line_linked: {
                        enable: true,
                        distance: 150,
                        color: "#3498db",
                        opacity: 0.2,
                        width: 1
                    },
                    move: {
                        enable: true,
                        speed: 2,
                        direction: "none",
                        random: true,
                        straight: false,
                        out_mode: "out",
                        bounce: false
                    }
                },
                interactivity: {
                    detect_on: "canvas",
                    events: {
                        onhover: {
                            enable: true,
                            mode: "repulse"
                        },
                        onclick: {
                            enable: true,
                            mode: "push"
                        },
                        resize: true
                    }
                }
            });
        }

        // Add ripple effect to buttons
        document.addEventListener('DOMContentLoaded', function() {
            const buttons = document.querySelectorAll('.btn');
            buttons.forEach(button => {
                button.addEventListener('click', function(e) {
                    const ripple = document.createElement('span');
                    const rect = button.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = e.clientX - rect.left - size / 2;
                    const y = e.clientY - rect.top - size / 2;

                    ripple.style.width = ripple.style.height = size + 'px';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.classList.add('ripple');

                    this.appendChild(ripple);

                    setTimeout(() => {
                        ripple.remove();
                    }, 600);
                });
            });
        });

        // Tutorial system
        const tutorialSteps = [
            {
                icon: '🚀',
                title: 'Welcome to ClaimIT!',
                description: 'Let me show you around the Contract Monthly Claim System. This tutorial will help you get started quickly.',
                highlight: 'We\'ll cover the main features in just a few steps.'
            },
            {
                icon: '📊',
                title: 'Dashboard Overview',
                description: 'Your dashboard shows all important metrics at a glance. Track total claims, pending approvals, and completed submissions.',
                highlight: 'The stat cards update in real-time as claims are processed.'
            },
            {
                icon: '📝',
                title: 'Submitting Claims',
                description: 'Click "Submit New Claim" to start. Fill in hours worked, hourly rate, and upload supporting documents.',
                highlight: 'Documents help coordinators verify your claims faster.'
            },
            {
                icon: '✅',
                title: 'Approval Workflow',
                description: 'Claims go through verification and approval stages. Coordinators review before final approval.',
                highlight: 'Track your claim status in real-time with color-coded badges.'
            },
            {
                icon: '🎯',
                title: 'Ready to Start!',
                description: 'You\'re all set! Start by submitting your first claim or explore the dashboard features.',
                highlight: 'Need help? Click the help icon anytime.'
            }
        ];

        let currentTutorialStep = 0;

        function showTutorial() {
            const tutorialOverlay = document.getElementById('tutorialOverlay');
            if (tutorialOverlay) {
                tutorialOverlay.classList.remove('hidden');
                showTutorialStep(0);
            }
        }

        function showTutorialStep(stepIndex) {
            currentTutorialStep = stepIndex;
            const step = tutorialSteps[stepIndex];
            const content = document.getElementById('tutorialContent');

            if (content && step) {
                content.innerHTML = `
                    <div class="tutorial-content">
                        <div class="tutorial-icon">${step.icon}</div>
                        <h3 class="tutorial-title">${step.title}</h3>
                        <p class="tutorial-description">${step.description}</p>
                        <div class="tutorial-highlight">${step.highlight}</div>
                        <div class="tutorial-step-indicators">
                            ${tutorialSteps.map((_, index) =>
                                `<div class="tutorial-step-dot ${index === stepIndex ? 'active' : ''}"></div>`
                            ).join('')}
                        </div>
                    </div>
                `;

                // Update navigation
                document.getElementById('tutorialStep').textContent = stepIndex + 1;
                document.getElementById('tutorialTotal').textContent = tutorialSteps.length;

                // Update buttons
                const prevBtn = document.getElementById('tutorialPrev');
                const nextBtn = document.getElementById('tutorialNext');
                const completeBtn = document.getElementById('tutorialComplete');

                if (prevBtn) prevBtn.style.display = stepIndex === 0 ? 'none' : 'inline-block';
                if (nextBtn) nextBtn.style.display = stepIndex === tutorialSteps.length - 1 ? 'none' : 'inline-block';
                if (completeBtn) completeBtn.style.display = stepIndex === tutorialSteps.length - 1 ? 'inline-block' : 'none';
            }
        }

        function completeTutorial() {
            const tutorialOverlay = document.getElementById('tutorialOverlay');
            if (tutorialOverlay) {
                tutorialOverlay.classList.add('hidden');
                localStorage.setItem('claimit_tutorial_completed', 'true');
                showNotification('Tutorial completed! You\'re ready to use ClaimIT.', 'success');
            }
        }

        // Tutorial event listeners
        document.addEventListener('DOMContentLoaded', function() {
            const nextBtn = document.getElementById('tutorialNext');
            const prevBtn = document.getElementById('tutorialPrev');
            const completeBtn = document.getElementById('tutorialComplete');
            const tutorialOverlay = document.getElementById('tutorialOverlay');
            const helpButton = document.getElementById('helpButton');

            if (nextBtn) {
                nextBtn.addEventListener('click', function() {
                    if (currentTutorialStep < tutorialSteps.length - 1) {
                        showTutorialStep(currentTutorialStep + 1);
                    }
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function() {
                    if (currentTutorialStep > 0) {
                        showTutorialStep(currentTutorialStep - 1);
                    }
                });
            }

            if (completeBtn) {
                completeBtn.addEventListener('click', completeTutorial);
            }

            if (tutorialOverlay) {
                tutorialOverlay.addEventListener('click', function(e) {
                    if (e.target === this) {
                        completeTutorial();
                    }
                });
            }

            if (helpButton) {
                helpButton.addEventListener('click', showTutorial);
            }
        });

        function showNotification(message, type) {
            // Create notification element
            const notification = document.createElement('div');
            notification.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            notification.innerHTML = `
                <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(notification);

            // Auto remove after 5 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 5000);
        }

        // Role-based UI enhancements
        document.addEventListener('DOMContentLoaded', function() {
            // Add subtle animations to role-specific elements
            const roleSections = document.querySelectorAll('.role-section');
            roleSections.forEach(section => {
                section.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateX(5px)';
                    this.style.transition = 'transform 0.3s ease';
                });

                section.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateX(0)';
                });
            });

            // Update pending claims count (this would typically come from an API)
            updatePendingClaimsCount();
        });

        function updatePendingClaimsCount() {
            // This would typically make an API call to get the actual count
            // For demo purposes, we'll use a random number
            const pendingCount = Math.floor(Math.random() * 5);
            const approvalQueueBadge = document.querySelector('.nav-link[href*="ApprovalQueue"] .badge');

            if (approvalQueueBadge) {
                if (pendingCount > 0) {
                    approvalQueueBadge.textContent = pendingCount;
                    approvalQueueBadge.style.display = 'inline';
                } else {
                    approvalQueueBadge.style.display = 'none';
                }
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    public string GetUserInitials(string userName)
    {
        if (string.IsNullOrEmpty(userName))
            return "?";

        var names = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (names.Length >= 2)
            return $"{names[0][0]}{names[1][0]}".ToUpper();
        else if (names.Length == 1 && names[0].Length >= 2)
            return names[0].Substring(0, 2).ToUpper();
        else
            return "US";
    }

    public string GetRoleBadgeClass(string role)
    {
        return role?.ToLower() switch
        {
            "lecturer" => "badge-lecturer",
            "coordinator" => "badge-coordinator",
            "manager" => "badge-manager",
            "hr" => "badge-hr",
            _ => "badge-secondary"
        };
    }
}