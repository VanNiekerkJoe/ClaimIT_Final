@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2 text-center">
            <h1 class="display-4 text-danger">Access Denied</h1>
            <p class="lead">You do not have permission to perform this action.</p>
            <hr />
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Back to Dashboard</a>
            <a asp-controller="Claims" asp-action="Index" class="btn btn-secondary btn-lg">View My Claims</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Optional: auto-redirect after 5 seconds
        setTimeout(() => {
            window.location.href = '@Url.Action("Index", "Claims")';
        }, 8000);
    </script>
}